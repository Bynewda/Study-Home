{
  "manifest_version": 3,
  "name": "논결(NONGYEOL) · LearnUs 자동 동기화",
  "version": "1.1.1",
  "description": "비밀번호 입력 없이 LearnUs 접속 시 및 논결(변리사 2차 수험실) 열람 시 수강 과목·과제 마감·중요 공지를 백그라운드에서 자동 동기화합니다.",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.learnus.org/*",
    "https://study-space-2027.netlify.app/*",
    "https://bynewda.github.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://study-space-2027.netlify.app/*",
        "https://bynewda.github.io/Study-Home/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
