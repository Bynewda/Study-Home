{
  "manifest_version": 3,
  "name": "논결(NONGYEOL) · LearnUs 동기화 & EXAONE AI 브리지",
  "version": "1.2.0",
  "description": "비밀번호 입력 없이 LearnUs 과제·공지를 자동 동기화하고, K-EXAONE 2.5 미니 어시스턴트의 브라우저 CORS 차단을 우회해 연결합니다.",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.learnus.org/*",
    "https://api.exaone.ai/*",
    "https://*.exaone.ai/*",
    "https://study-space-2027.netlify.app/*",
    "https://bynewda.github.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://study-space-2027.netlify.app/*",
        "https://bynewda.github.io/Study-Home/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
