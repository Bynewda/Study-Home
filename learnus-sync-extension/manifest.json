{
  "manifest_version": 3,
  "name": "나의 수험 공간 · LearnUs 1클릭 동기화",
  "version": "1.0.0",
  "description": "비밀번호 입력 없이 로그인된 연세 LearnUs에서 수강 과목·과제 마감·중요 공지를 나의 수험 공간으로 1클릭 동기화합니다.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.learnus.org/*",
    "https://study-space-2027.netlify.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://study-space-2027.netlify.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
